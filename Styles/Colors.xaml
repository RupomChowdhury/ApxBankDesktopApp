<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Modern Light FinTech Theme Colors (Maltnessa & Financely Style) -->
    <Color x:Key="ColorBg">#F8FAFC</Color>
    <Color x:Key="ColorSidebar">#FFFFFF</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceHover">#F1F5F9</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorCardBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderSubtle">#E2E8F0</Color>

    <!-- Accent Palettes -->
    <Color x:Key="ColorEmerald">#10B981</Color>
    <Color x:Key="ColorEmeraldDark">#059669</Color>
    <Color x:Key="ColorEmeraldPill">#ECFDF5</Color>
    <Color x:Key="ColorEmeraldGlow">#2010B981</Color>
    <Color x:Key="ColorCyan">#0284C7</Color>
    <Color x:Key="ColorCyanPill">#EFF6FF</Color>
    <Color x:Key="ColorIndigo">#6366F1</Color>
    <Color x:Key="ColorPurple">#8B5CF6</Color>
    <Color x:Key="ColorRose">#E11D48</Color>
    <Color x:Key="ColorRosePill">#FFE4E6</Color>
    <Color x:Key="ColorAmber">#D97706</Color>
    <Color x:Key="ColorAmberPill">#FEF3C7</Color>

    <!-- Text Colors (Deep Slate High Contrast) -->
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>
    <Color x:Key="ColorTextMuted">#94A3B8</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}"/>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>

    <SolidColorBrush x:Key="BrushEmerald" Color="{StaticResource ColorEmerald}"/>
    <SolidColorBrush x:Key="BrushEmeraldDark" Color="{StaticResource ColorEmeraldDark}"/>
    <SolidColorBrush x:Key="BrushEmeraldPill" Color="{StaticResource ColorEmeraldPill}"/>
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}"/>
    <SolidColorBrush x:Key="BrushCyanPill" Color="{StaticResource ColorCyanPill}"/>
    <SolidColorBrush x:Key="BrushIndigo" Color="{StaticResource ColorIndigo}"/>
    <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColorPurple}"/>
    <SolidColorBrush x:Key="BrushRose" Color="{StaticResource ColorRose}"/>
    <SolidColorBrush x:Key="BrushRosePill" Color="{StaticResource ColorRosePill}"/>
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}"/>
    <SolidColorBrush x:Key="BrushAmberPill" Color="{StaticResource ColorAmberPill}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

    <!-- Linear Gradients -->
    <LinearGradientBrush x:Key="BrushAuthHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#091420" Offset="0.0"/>
        <GradientStop Color="#063228" Offset="0.4"/>
        <GradientStop Color="#064E3B" Offset="0.8"/>
        <GradientStop Color="#022018" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAuthBgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1F5F9" Offset="0.0"/>
        <GradientStop Color="#F8FAFC" Offset="0.5"/>
        <GradientStop Color="#E2E8F0" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardVirtualGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#064E3B" Offset="0.0"/>
        <GradientStop Color="#065F46" Offset="0.3"/>
        <GradientStop Color="#0F172A" Offset="0.75"/>
        <GradientStop Color="#022C22" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryBtnGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushIndigoBtnGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#4F46E5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardFrozenOverlay" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D00284C7" Offset="0"/>
        <GradientStop Color="#E00369A1" Offset="1"/>
    </LinearGradientBrush>

    <!-- Smooth Chart Gradients -->
    <LinearGradientBrush x:Key="BrushChartAreaGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3010B981" Offset="0"/>
        <GradientStop Color="#0510B981" Offset="0.75"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
