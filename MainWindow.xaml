                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ROUTING NUMBER" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewBenRouting, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ACCOUNT / WALLET NO" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewBenAccount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="CATEGORY / NICKNAME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewBenCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource SecondaryBtn}" Height="42" Margin="0,0,6,0" Command="{Binding CloseAddBeneficiaryCommand}">
                                            <TextBlock Text="Cancel"/>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryBtn}" Height="42" Margin="6,0,0,0" Command="{Binding SaveBeneficiaryCommand}">
                                            <TextBlock Text="Save Beneficiary"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- ============================================================ -->
                        <!-- NOTIFICATIONS CENTER FLYOUT PANEL                            -->
                        <!-- ============================================================ -->
                        <Grid Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="125">
                            <!-- Click outside to dismiss -->
                            <Border Background="#20000000">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNotificationsCommand}"/>
                                </Border.InputBindings>
                            </Border>

                            <!-- Floating Flyout Card -->
                            <Border Style="{StaticResource ModernCard}" Width="380" MaxHeight="520" Margin="0,8,18,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.12" Color="#0F172A"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Notifications &amp; Alerts" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                            <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding UnreadNotificationCount, StringFormat='{}{0} New'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource TitleBarBtn}" Width="28" Height="28" Command="{Binding CloseNotificationsCommand}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <!-- Notification Items -->
                                    <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushEmeraldPill}" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                <Path Data="{StaticResource IconBell}" Fill="{StaticResource BrushEmeraldDark}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, h:mm tt}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="9" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{StaticResource BrushEmerald}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                                                                 Visibility="{Binding IsRead, Converter={StaticResource InvBoolToVisConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Footer Action -->
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryBtn}" Height="32" Margin="0,10,0,0" Command="{Binding MarkAllNotificationsReadCommand}">
                                        <TextBlock Text="Mark All as Read" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================================ -->
                        <!-- FLOATING TOAST NOTIFICATION                                  -->
                        <!-- ============================================================ -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"
                            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisConverter}}"
                            Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushEmerald}" BorderThickness="1.5"
                            CornerRadius="10" Padding="16,12" Panel.ZIndex="200"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.10" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Fill="{StaticResource BrushEmerald}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
                <!-- /AUTHENTICATED WORKSPACE -->

                <!-- ================================================================ -->
                <!-- AUTHENTICATION & REGISTRATION SCREEN (When Logged Out)            -->
                <!-- ================================================================ -->
                <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InvBoolToVisConverter}}" Background="{StaticResource BrushAuthBgGradient}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,32">
                        <!-- Master Dual-Pane Card Container -->
                        <Border MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#FFFFFF" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420"/>
                                    <!-- Left: Institutional Showcase Hero -->
                                    <ColumnDefinition Width="560"/>
                                    <!-- Right: Secure Auth & Access Portal -->
                                </Grid.ColumnDefinitions>

                                <!-- ======================================================== -->
                                <!-- LEFT PANE: INSTITUTIONAL BRAND & SECURITY SHOWCASE        -->
                                <!-- ======================================================== -->
                                <Border Grid.Column="0" Background="{StaticResource BrushAuthHeroGradient}" CornerRadius="20,0,0,20" Padding="36,36">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Top Brand & Live Badge -->
                                            <RowDefinition Height="*"/>
                                            <!-- Feature Value Props -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Bottom Trust & Regulation -->
                                        </Grid.RowDefinitions>

                                        <!-- Top Brand & Live Status -->
                                        <StackPanel Grid.Row="0">
                                            <!-- Live Engine Status Badge -->
                                            <Border CornerRadius="12" Background="#152E38" BorderBrush="#065F46" BorderThickness="1"
                                                    Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,24">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushEmerald}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CORE BANKING ENGINE • ONLINE" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Brand Monogram & Name -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Width="48" Height="48" CornerRadius="14" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconBankPillars}" Fill="#34D399" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="APX Bank PLC" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                    <TextBlock Text="Corporate &amp; Retail Treasury" Foreground="#94A3B8" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Text="Institutional financial cloud and real-time clearing gateway."
                                                       Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,24" LineHeight="18"/>
                                        </StackPanel>

                                        <!-- Feature Highlights -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,20">
                                            <!-- Feature 1: Multi-Rail Clearing -->
                                            <Border Background="#0D1E2D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#064E3B" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Data="{StaticResource IconIncome}" Fill="#34D399" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Multi-Rail Settlement" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Real-time clearing via NPSB, BEFTN &amp; RTGS networks." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Feature 2: Hardware Cryptography -->
                                            <Border Background="#0D1E2D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#0C4A6E" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Data="{StaticResource IconShieldCheck}" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Cryptographic Vault" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Hardware-grade AES-256-GCM data encryption." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Feature 3: Smart Cards & Analytics -->
                                            <Border Background="#0D1E2D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1E1B4B" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Path Data="{StaticResource IconCards}" Fill="#A5B4FC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Virtual Debit Studio" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Dynamic limits, one-touch lock &amp; instant statement export." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Bottom Regulatory & Compliance Pill -->
                                        <Border Grid.Row="2" Background="#071822" BorderBrush="#163140" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconLock}" Fill="#10B981" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Regulated by Bangladesh Bank • ISO 27001 Certified" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ======================================================== -->
                                <!-- RIGHT PANE: INTERACTIVE AUTHENTICATION & REGISTRATION    -->
                                <!-- ======================================================== -->
                                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="0,20,20,0" Padding="38,36">
                                    <StackPanel>
                                        <!-- Status Pill -->
                                        <Border Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushEmerald}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="SECURE CLIENT ACCESS" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Context-Aware Dynamic Header -->
                                        <Grid Margin="0,0,0,18">
                                            <!-- Sign In Mode Header -->
                                            <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource InvBoolToVisConverter}}">
                                                <TextBlock Text="Welcome Back" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Sign in with your verified credentials to access your financial dashboard." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Register Mode Header -->
                                            <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Open APX Bank Account" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Register your institutional or personal profile to begin digital banking." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Interactive Segmented Tab Switcher -->
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="4" Margin="0,0,0,20">
                                            <Grid>
                                                <!-- State 1: Sign In Active -->
                                                <Grid Visibility="{Binding IsRegisterMode, Converter={StaticResource InvBoolToVisConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Active Sign In Tab Card -->
                                                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                                        <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Height="36">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Path Data="{StaticResource IconLock}" Fill="{StaticResource BrushEmeraldDark}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Sign In" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                    <!-- Inactive Register Tab Button -->
                                                    <Button Grid.Column="1" Style="{StaticResource PillBtn}" Height="36" BorderThickness="0" HorizontalAlignment="Stretch" Command="{Binding SwitchAuthModeCommand}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Create Account" FontWeight="Normal" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- State 2: Register Active -->
                                                <Grid Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Inactive Sign In Tab Button -->
                                                    <Button Grid.Column="0" Style="{StaticResource PillBtn}" Height="36" BorderThickness="0" HorizontalAlignment="Stretch" Command="{Binding SwitchAuthModeCommand}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Path Data="{StaticResource IconLock}" Fill="{StaticResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Sign In" FontWeight="Normal" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Active Register Tab Card -->
                                                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                                        <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Height="36">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrushEmeraldDark}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Create Account" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- ==================================================== -->
                                        <!-- TAB 1 CONTENT: SIGN IN FORM                          -->
                                        <!-- ==================================================== -->
                                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource InvBoolToVisConverter}}">
                                            <!-- Username Field -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrushEmeraldDark}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Username" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="44" Background="#F8FAFC"
                                                     Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                                            <!-- Password Field -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Path Data="{StaticResource IconLock}" Fill="{StaticResource BrushEmeraldDark}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Password" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <PasswordBox x:Name="TxtLoginPassword" Style="{StaticResource ModernPasswordBox}" Height="44" Background="#F8FAFC"
                                                         PasswordChanged="LoginPassword_PasswordChanged" Margin="0,0,0,16"/>

                                            <!-- Error Message Alert Banner -->
                                            <Border Background="{StaticResource BrushRosePill}" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                                    Visibility="{Binding LoginErrorMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushRose}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding LoginErrorMessage}" Foreground="{StaticResource BrushRose}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Sign In Button -->
                                            <Button Style="{StaticResource PrimaryBtn}" Height="46" HorizontalAlignment="Stretch"
                                                    Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=TxtLoginPassword}" Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="Sign In" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource IconArrowRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Divider with Label -->
                                            <Grid Margin="0,0,0,16">
                                                <Border Height="1" Background="{StaticResource BrushBorderSubtle}" VerticalAlignment="Center"/>
                                                <Border Background="#FFFFFF" HorizontalAlignment="Center" Padding="12,0">
                                                    <TextBlock Text="OR INSTANT DEMO ACCESS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Elegant Quick Demo Card -->
                                            <Button Style="{StaticResource SecondaryBtn}" Height="54" HorizontalAlignment="Stretch"
                                                    Command="{Binding QuickDemoLoginCommand}" Margin="0,0,0,16" Padding="12,6" Background="#F8FAFC">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconSparkles}" Fill="{StaticResource BrushEmeraldDark}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left">
                                                        <TextBlock Text="Demo Account" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="1-Click Launch" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                        </StackPanel>

                                        <!-- ==================================================== -->
                                        <!-- TAB 2 CONTENT: REGISTER FORM                         -->
                                        <!-- ==================================================== -->
                                        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisConverter}}">
                                            <!-- Full Name -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrushEmeraldDark}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Full Legal Name" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBox Style="{StaticResource ModernTextBox}" Height="40" Background="#F8FAFC"
                                                     Text="{Binding RegFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                            <!-- Two Column: Username & Email -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Username -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Desired Username" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40" Background="#F8FAFC"
                                                             Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>

                                                <!-- Email -->
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Email Address" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40" Background="#F8FAFC"
                                                             Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Two Column: Password & Confirm -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Password -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Password (Min 6 chars)" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <PasswordBox x:Name="TxtRegPassword" Style="{StaticResource ModernPasswordBox}" Height="40" Background="#F8FAFC"
                                                                 PasswordChanged="RegPassword_PasswordChanged"/>
                                                </StackPanel>

                                                <!-- Confirm Password -->
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Confirm Password" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <PasswordBox x:Name="TxtRegConfirmPassword" Style="{StaticResource ModernPasswordBox}" Height="40" Background="#F8FAFC"
                                                                 PasswordChanged="RegConfirmPassword_PasswordChanged"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Error Message Alert Banner -->
                                            <Border Background="{StaticResource BrushRosePill}" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                                    Visibility="{Binding RegErrorMessage, Converter={StaticResource StringNullOrEmptyToVisConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushRose}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RegErrorMessage}" Foreground="{StaticResource BrushRose}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Create Account Button -->
                                            <Button Style="{StaticResource PrimaryBtn}" Height="46" HorizontalAlignment="Stretch"
                                                    Command="{Binding RegisterCommand}" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="Complete Registration" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource IconArrowRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Bottom Encryption Guarantee Line -->
                                        <Border Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource BrushEmeraldDark}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Secured and Encrypted" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
