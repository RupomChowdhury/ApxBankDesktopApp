<Window x:Class="ApexBank.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ApexBank.ViewModels"
        mc:Ignorable="d"
        Title="APX Bank PLC" 
        Icon="Assets/app_icon.ico"
        Height="840" Width="1360"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Container with Rounded Border and Ambient Glow -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BrushBg}" 
            BorderBrush="{StaticResource BrushCardBorder}" 
            BorderThickness="1" 
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- Custom Modern Header Bar -->
                <RowDefinition Height="*"/>
                <!-- Main Work Area -->
            </Grid.RowDefinitions>

            <!-- ==================================================================== -->
            <!-- CUSTOM TITLE BAR (Maltnessa & Financely Integrated Header)           -->
            <!-- ==================================================================== -->
            <Border Grid.Row="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="202"/>
                        <!-- Brand & Logo aligned with Sidebar -->
                        <ColumnDefinition Width="*"/>
                        <!-- Center: Search & Status / Draggable -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Right Actions & Window Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- APX Bank PLC Logo & Tag -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <Image Source="Assets/SecuredRelay.png" Width="32" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="APX Bank PLC" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Width="130" Height="25"/>
                    </StackPanel>

                    <!-- Center: Search Pill & Live Connection Status (Visible only when authenticated) -->
                    <Grid Grid.Column="1" Margin="12,0,16,0" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Pill Input (Matching Maltnessa & Financely Mockups) -->
                        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Width="280" Height="34" VerticalAlignment="Center">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                                         Padding="0"/>
                            </Grid>
                        </Border>

                        <!-- Center Security Status Pill -->
                        <Border Grid.Column="2" Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushEmerald}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE EXCEL DATABASE • SYNCHRONIZED" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right Quick Info, User Avatar Chip & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notification Bell Button (Visible only when authenticated) -->
                        <Button Style="{StaticResource TitleBarBtn}" Command="{Binding ToggleNotificationsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Security &amp; Transaction Notifications" Width="36" Height="32" Margin="0,0,8,0"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Path Data="{StaticResource IconBell}" Fill="{StaticResource BrushTextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushEmerald}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0"
                                         Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- User Profile Avatar Pill (Matching Maltnessa & Financely Mockups) -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="3,2,8,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushEmerald}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CurrentUserInitials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource TitleBarBtn}" Width="20" Height="20" ToolTip="Sign Out" Command="{Binding LogoutCommand}" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushRose}" Width="8" Height="8" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Window Controls -->
                        <Button Style="{StaticResource TitleBarBtn}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="2" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize / Restore">
                            <Path Data="{StaticResource IconMaximize}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseBtn}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================================================================== -->
            <!-- MAIN WORKSPACE: SIDEBAR + CONTENT STAGE                              -->
            <!-- ==================================================================== -->
            <Grid Grid.Row="1">
                <!-- AUTHENTICATED WORKSPACE -->
                <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <!-- Left Navigation Sidebar (Slim, Clean 220px) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Dynamic View Stage -->
                    </Grid.ColumnDefinitions>

                    <!-- ================================================================ -->
                    <!-- SIDEBAR (Zero Scrollbars • Pure Maltnessa FinTech Style)          -->
                    <!-- ================================================================ -->
                    <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                        <Grid Margin="14,18,14,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Section Label -->
                                <RowDefinition Height="*"/>
                                <!-- Nav Items -->
                                <RowDefinition Height="Auto"/>
                                <!-- Bottom Net Assets Card -->
                            </Grid.RowDefinitions>

                            <!-- Section Header -->
                            <TextBlock Grid.Row="0" Text="MAIN MENU" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="10,0,0,12"/>

                            <!-- Navigation Items (Static StackPanel - No ScrollViewer, No Scrollbar!) -->
                            <StackPanel Grid.Row="1">
                                <!-- Dashboard -->
                                <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardView}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDashboard}" Fill="{StaticResource BrushEmerald}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Transfers & Pay -->
                                <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Transfers" Tag="{Binding IsTransfersView}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconArrowUpRight}" Fill="{StaticResource BrushEmerald}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Transfers &amp; Pay" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cards Studio -->
                                <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Cards" Tag="{Binding IsCardsView}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCards}" Fill="{StaticResource BrushIndigo}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Cards Studio" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Analytics & Budget -->
                                <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Analytics" Tag="{Binding IsAnalyticsView}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAnalytics}" Fill="{StaticResource BrushPurple}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="Analytics &amp; Budget" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- All Transactions (In-App Ledger) -->
                                <Button Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Transactions" Tag="{Binding IsTransactionsView}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTransfer}" Fill="{StaticResource BrushCyan}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0"/>
                                        <TextBlock Text="All Transactions" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Net Assets Card & Deposit CTA -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL NET ASSETS" Foreground="{StaticResource BrushTextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TotalNetWorth, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Path Data="{StaticResource IconTrendingUp}" Fill="{StaticResource BrushEmeraldDark}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="+5.4% this month" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource PrimaryBtn}" Height="38" Command="{Binding OpenDepositDialogCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Deposit Funds" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================================================================ -->
                    <!-- MAIN VIEW CONTAINER                                              -->
                    <!-- ================================================================ -->
                    <Grid Grid.Column="1" Background="{StaticResource BrushBg}">

                        <!-- ============================================================ -->
                        <!-- VIEW 1: DASHBOARD (Default)                                  -->
                        <!-- ============================================================ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,36"
                                  Visibility="{Binding CurrentView, Converter={StaticResource EqToVisConverter}, ConverterParameter='Dashboard'}">
                            <Grid Margin="28,24,28,28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 0: Top Greeting & Quick Actions -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 1: 4 Top KPI Metric Cards (UniformGrid) -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 2: Account Quick Switcher Pill Bar -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 3: Dual Column: Spline Area Chart + Quick Transfer & Card -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row 4: Recent Transactions Data Table -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Greeting & Quick Actions -->
                                <Grid Grid.Row="0" Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUserName, StringFormat='Welcome back, {0}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="Unified real-time banking command center • APX Bank PLC" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Command="{Binding OpenDepositDialogCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add Funds"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding NavigateCommand}" CommandParameter="Transfers">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconArrowUpRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Send Money"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: 4 Top KPI Metric Cards (Maltnessa & Financely Mockups) -->
                                <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,20">
                                    <!-- KPI Card 1: Total Net Assets -->
                                    <Border Style="{StaticResource ModernCard}" Margin="6,0" Padding="20,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="TOTAL NET ASSETS" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                                                <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="+14.2% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding TotalNetWorth, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Consolidated portfolio balance" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI Card 2: Checking Balance (Active Account) -->
                                    <Border Style="{StaticResource ModernCard}" Margin="6,0" Padding="20,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedAccount.Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="{Binding SelectedAccount.AccountNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedAccount.Balance, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Primary operating liquidity" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI Card 3: Monthly Inflow -->
                                    <Border Style="{StaticResource ModernCard}" Margin="6,0" Padding="20,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="MONTHLY INFLOW" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                                                <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="+8.5% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding TotalMonthlyInflow, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="30-day verified deposits" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KPI Card 4: Net Cashflow / Retained Surplus -->
                                    <Border Style="{StaticResource ModernCard}" Margin="6,0" Padding="20,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="NET CASHFLOW" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                                                <Border Grid.Column="1" Background="{StaticResource BrushCyanPill}" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="{Binding SavingsRate, StringFormat='{}{0:F1}% RATE'}" Foreground="{StaticResource BrushCyan}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding NetMonthlySavings, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Net monthly savings retained" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Row 2: Account Quick Switcher Pill Bar -->
                                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0">
                                            <Path Data="{StaticResource IconBankPillars}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SELECT ACCOUNT:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Accounts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,10,0" CornerRadius="8" Cursor="Hand" Padding="12,6" SnapsToDevicePixels="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushEmerald}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushEmerald}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" 
                                                                      Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                      CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Balance, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Height="30" Padding="12,0" Command="{Binding OpenDepositDialogCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Deposit" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Row 3: Dual Column (Spline Cashflow Area Chart + Quick Transfer & Card) -->
                                <Grid Grid.Row="3" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="38*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN: Spline Cashflow Area Chart (Maltnessa Image 4) -->
                                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="22">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <!-- Title & Time Period Filter Pills -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Stat Highlight Banner -->
                                                <RowDefinition Height="220"/>
                                                <!-- Vector Spline Area Chart -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Day Markers & Legend -->
                                            </Grid.RowDefinitions>

                                            <!-- Header & Filter Pills -->
                                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Cashflow &amp; Analytics" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Income vs expense trend over selected timeframe" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource PillBtn}" Content="1D" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Content="1W" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Content="1M" Height="28" Padding="10,0" Margin="0,0,2,0" Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" Foreground="{StaticResource BrushEmeraldDark}" FontWeight="Bold"/>
                                                        <Button Style="{StaticResource PillBtn}" Content="1Y" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                                        <Button Style="{StaticResource PillBtn}" Content="All" Height="28" Padding="10,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Stat Highlight Banner -->
                                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <TextBlock Text="৳92,400.00" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                                    <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,3" Margin="10,0,0,4" VerticalAlignment="Center">
                                                        <TextBlock Text="+18.4% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="30-day continuous cashflow curve" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>

                                            <!-- Spline Area Chart (Canvas with Translucent Fill & Pin) -->
                                            <Grid Grid.Row="2" ClipToBounds="True">
                                                <!-- Dotted horizontal reference lines -->
                                                <Grid VerticalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                                    <Border Grid.Row="1" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                                                </Grid>

                                                <!-- Chart Spline Vector Path -->
                                                <Viewbox Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                    <Canvas Width="700" Height="200">
                                                        <!-- Translucent Gradient Shaded Area -->
                                                        <Path Fill="{StaticResource BrushChartAreaGradient}"
                                                          Data="M 0,165 C 50,150 90,120 140,125 C 190,130 230,85 290,80 C 350,75 390,115 450,85 C 510,55 550,30 610,35 C 650,38 675,20 700,25 L 700,200 L 0,200 Z"/>

                                                        <!-- Smooth Curve Stroke -->
                                                        <Path Stroke="{StaticResource BrushEmerald}" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 0,165 C 50,150 90,120 140,125 C 190,130 230,85 290,80 C 350,75 390,115 450,85 C 510,55 550,30 610,35 C 650,38 675,20 700,25"/>

                                                        <!-- Peak Data Pin Pulse Halo -->
                                                        <Ellipse Canvas.Left="600" Canvas.Top="25" Width="20" Height="20" Fill="#2010B981"/>
                                                        <!-- Peak Data Pin Core Dot -->
                                                        <Ellipse Canvas.Left="605" Canvas.Top="30" Width="10" Height="10" Fill="{StaticResource BrushEmerald}"/>
                                                        <Ellipse Canvas.Left="607.5" Canvas.Top="32.5" Width="5" Height="5" Fill="#FFFFFF"/>

                                                        <!-- Floating Value Tooltip Pill -->
                                                        <Border Canvas.Left="545" Canvas.Top="0" Background="#0F172A" CornerRadius="6" Padding="8,4">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                                                            </Border.Effect>
                                                            <TextBlock Text="14 Sep: ৳92,400" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>

                                            <!-- Day Markers & Legend -->
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Day Markers -->
                                                <UniformGrid Grid.Column="0" Columns="7" Margin="0,0,16,0">
                                                    <TextBlock Text="Mon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Tue" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Wed" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Thu" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Fri" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Sat" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                                    <TextBlock Text="Sun" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                                </UniformGrid>

                                                <!-- Legend -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushEmerald}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Inflow" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,14,0"/>
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushRose}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Outflow" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- RIGHT COLUMN: Quick Transfer & Platinum Virtual Card (Financely Image 1) -->
                                    <StackPanel Grid.Column="2">
                                        <!-- QUICK SEND TRANSFER WIDGET -->
                                        <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Quick Transfer" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                                <!-- Beneficiaries Avatar Horizontal Row -->
                                                <TextBlock Text="FREQUENT BENEFICIARIES" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Beneficiaries}" Margin="0,0,0,12">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                                                                Command="{Binding DataContext.SelectBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                                <StackPanel Width="60" HorizontalAlignment="Center">
                                                                    <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding AvatarInitials}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Recipient Name Input -->
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransferRecipientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="38"/>

                                                <!-- Amount Input with Quick Chips -->
                                                <Grid Margin="0,0,0,8">
                                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,8"/>
                                                </Grid>

                                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳500" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳2,500" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="2500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳10k" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="10000"/>
                                                </UniformGrid>

                                                <!-- Transfer Action Button -->
                                                <Button Style="{StaticResource PrimaryBtn}" Height="40" Command="{Binding ExecuteTransferCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconArrowUpRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Transfer Now" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- VIRTUAL CARD PREVIEW WIDGET -->
                                        <Border Style="{StaticResource ModernCard}" Padding="18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Virtual Debit Card" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" 
                                                            Command="{Binding ToggleRevealCardCommand}" Content="{Binding RevealButtonText}" FontSize="11"/>
                                                        <Button Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" 
                                                            Command="{Binding ToggleFreezeCardCommand}">
                                                            <TextBlock Text="Freeze" Foreground="{StaticResource BrushRose}" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Compact Card Surface -->
                                                <Border Height="165" CornerRadius="12" Background="{StaticResource BrushCardVirtualGradient}" BorderBrush="#255D4E" BorderThickness="1" ClipToBounds="True">
                                                    <Grid Margin="16,14">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Frozen Overlay -->
                                                        <Border Grid.RowSpan="3" Background="{StaticResource BrushCardFrozenOverlay}" 
                                                            Visibility="{Binding Card.IsFrozen, Converter={StaticResource BoolToVisConverter}}"
                                                            CornerRadius="12" Margin="-16,-14" Panel.ZIndex="10">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconLock}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <TextBlock Text="CARD FROZEN" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Top: Chip & Visa -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="22" Background="#D4AF37" CornerRadius="3" BorderBrush="#B8860B" BorderThickness="1"/>
                                                            <Path Grid.Column="1" Data="{StaticResource IconWave}" Fill="#E2E8F0" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                                            <TextBlock Grid.Column="2" Text="VISA" Foreground="White" FontSize="15" FontWeight="ExtraBold" FontStyle="Italic"/>
                                                        </Grid>

                                                        <!-- Middle: Masked / Full Number -->
                                                        <TextBlock Grid.Row="1" Text="{Binding DisplayedCardNumber}" 
                                                               Foreground="White" FontSize="16" FontWeight="Bold"
                                                               VerticalAlignment="Center" FontFamily="Consolas, Courier New"/>

                                                        <!-- Bottom: Cardholder, Expiry, CVV -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="CARDHOLDER" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Card.CardHolder}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                                <TextBlock Text="EXPIRES" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Card.Expiry}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="CVV" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DisplayedCvv}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 4: Recent Transactions Data Table (Maltnessa Image 5 Style) -->
                                <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="22">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Title & Controls Header -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Search & Filter Chips -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Table Column Headers -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Transactions List -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Footer Navigation -->
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Title & Count Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Recent Transactions" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="{StaticResource BrushCyanPill}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RecentTransactions.Count, StringFormat='{}Latest {0}'}" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Search & Filter Chips -->
                                        <Grid Grid.Row="1" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Search Box -->
                                            <Grid Grid.Column="0">
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" Height="36"/>
                                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Filter Pills -->
                                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="All"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Income" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Income"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Shopping" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Shopping"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Transfer" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Transfer"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Groceries" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Groceries"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Entertainment" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Entertainment"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Transport" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Transport"/>
                                            </WrapPanel>
                                        </Grid>

                                        <!-- Row 2: Table Column Headers -->
                                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,1" Padding="14,9" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="TRANSACTION &amp; DETAILS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="CATEGORY" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="STATUS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="DATE &amp; TIME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4" Text="AMOUNT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 3: Transactions Tabular List -->
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding RecentTransactions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,12" Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" 
                                                                      Command="{Binding DataContext.SelectTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                      CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Column 0: Icon + Title + Description -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="36" Height="36" CornerRadius="8" 
                                                                    Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <Path Data="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" 
                                                                      Fill="{StaticResource BrushTextPrimary}" Width="15" Height="15" Stretch="Uniform" 
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Column 1: Category Badge -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Column 2: Status Badge (Completed) -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                                    <TextBlock Text="Completed" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Column 3: Date & Time -->
                                                            <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, yyyy  h:mm tt}'}" 
                                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>

                                                            <!-- Column 4: Amount -->
                                                            <TextBlock Grid.Column="4" Text="{Binding Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                                   Foreground="{Binding Amount, Converter={StaticResource AmountColorConverter}}" 
                                                                   FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Row 4: Footer Navigation to Full Ledger -->
                                        <Button Grid.Row="4" Style="{StaticResource SecondaryBtn}" Height="36" Margin="0,12,0,0"
                                            Command="{Binding NavigateCommand}" CommandParameter="Transactions"
                                            ToolTip="Open full in-app transaction ledger to view, sort and filter all records">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="Open Full Transaction Ledger" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center"/>
                                                <Path Data="{StaticResource IconExternalLink}" Fill="{StaticResource BrushCyan}" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============================================================ -->
                        <!-- VIEW 2: TRANSFERS & PAY                                      -->
                        <!-- ============================================================ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36"
                                  Visibility="{Binding CurrentView, Converter={StaticResource EqToVisConverter}, ConverterParameter='Transfers'}">
                            <Grid Margin="24,20,24,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Transfers &amp; Payments" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="Zero-fee Same-Bank instant transfers, Bangladeshi national rails (NPSB, BEFTN, RTGS, MFS), and bill payment via card." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,14"/>

                                    <!-- Segmented Transfer Channels Pill Bar -->
                                    <Border Background="#F1F5F9" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource TabPillBtn}" Content="Same-Bank (৳0 Free)" 
                                                Command="{Binding SetTransferTabCommand}" CommandParameter="SameBank" Tag="{Binding IsSameBankTab}"/>
                                            <Button Style="{StaticResource TabPillBtn}" Content="Bangladeshi Bank Transfer (NPSB / BEFTN / RTGS / MFS)" 
                                                Command="{Binding SetTransferTabCommand}" CommandParameter="ExternalBD" Tag="{Binding IsExternalBdTab}"/>
                                            <Button Style="{StaticResource TabPillBtn}" Content="Pay via Card (Utilities &amp; Bills)" 
                                                Command="{Binding SetTransferTabCommand}" CommandParameter="CardPay" Tag="{Binding IsCardPayTab}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="490"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT COLUMN: ACTIVE CHANNEL FORM -->
                                    <Grid Grid.Column="0">
                                        <!-- TAB 1: SAME-BANK TRANSFER (FREE) -->
                                        <Border Style="{StaticResource ModernCard}" Padding="24"
                                            Visibility="{Binding IsSameBankTab, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="APX Bank Same-Bank Transfer" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock Text="Real-time instant settlement across APX Bank PLC network" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="FEE: ৳0.00 (FREE)" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Mode Toggle: Own Account vs Another APX Bank Customer -->
                                                <Border Background="#F1F5F9" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                                                    <UniformGrid Columns="2">
                                                        <Button Style="{StaticResource TabPillBtn}" Content="Between My Accounts" Height="32" FontSize="12"
                                                            Command="{Binding SetSameBankModeCommand}" CommandParameter="Own" Tag="{Binding IsSameBankOwnAccounts}"/>
                                                        <Button Style="{StaticResource TabPillBtn}" Content="To Other APX Bank Customer" Height="32" FontSize="12"
                                                            Command="{Binding SetSameBankModeCommand}" CommandParameter="Peer" Tag="{Binding IsSameBankPeer}"/>
