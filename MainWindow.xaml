                                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SameBankRecipientInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                                </StackPanel>

                                                <!-- Amount -->
                                                <TextBlock Text="TRANSFER AMOUNT (BDT)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SameBankAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳2,500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="2500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳10,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="10000"/>
                                                </UniformGrid>

                                                <!-- Note -->
                                                <TextBlock Text="TRANSFER NOTE / REFERENCE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SameBankNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                                                <!-- Zero Fee Highlight Banner -->
                                                <Border Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Same-Bank Free Transfer Guarantee" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold"/>
                                                            <TextBlock Text="No wire or interchange tariffs applied for internal network transactions." Foreground="#065F46" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="৳0.00" Foreground="{StaticResource BrushEmeraldDark}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <Button Style="{StaticResource PrimaryBtn}" Height="46" Command="{Binding ExecuteSameBankTransferCommand}">
                                                    <TextBlock Text="Authorize ৳0.00 Free Transfer" FontWeight="Bold" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- TAB 2: EXTERNAL BANGLADESHI BANK TRANSFER -->
                                        <Border Style="{StaticResource ModernCard}" Padding="24"
                                            Visibility="{Binding IsExternalBdTab, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Bangladeshi National Bank Transfer" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                                                <TextBlock Text="Connect via Bangladesh Bank NPSB, BEFTN, RTGS, or MFS wallets." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,14"/>

                                                <!-- Source Account -->
                                                <TextBlock Text="SOURCE ACCOUNT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedAccount}" ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" Margin="0,0,0,12"/>

                                                <!-- Destination Bank & Channel -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="DESTINATION BANK" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedBdBank}" ItemsSource="{Binding SupportedBanks}" DisplayMemberPath="BankName"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="TRANSFER CHANNEL / RAIL" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedBdChannel}" ItemsSource="{Binding BdChannels}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Routing Number & Account Number -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="ROUTING NUMBER" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BdRoutingNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="BENEFICIARY ACCOUNT / WALLET NO" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BdRecipientAccount, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Recipient Full Name -->
                                                <TextBlock Text="RECIPIENT FULL NAME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BdRecipientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                                <!-- Amount -->
                                                <TextBlock Text="TRANSFER AMOUNT (BDT)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BdAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳10,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="10000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳25,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="25000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳50,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="50000"/>
                                                </UniformGrid>

                                                <!-- Note -->
                                                <TextBlock Text="PURPOSE / PAYMENT REFERENCE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BdNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                                <!-- Save Beneficiary Checkbox -->
                                                <CheckBox Content="Save payee in Beneficiaries directory" IsChecked="{Binding BdSaveBeneficiary}" 
                                                      Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                                                <!-- Cost Breakdown Card -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SelectedBdChannel, StringFormat='Rail: {0}'}" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding BdFeeNotice}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="Total Debit" Foreground="{StaticResource BrushTextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding BdTotalDebit, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Button Style="{StaticResource PrimaryBtn}" Height="46" Command="{Binding ExecuteBdTransferCommand}">
                                                    <TextBlock Text="Authorize &amp; Dispatch Bangladeshi Transfer" FontWeight="Bold" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- TAB 3: PAY VIA CARD -->
                                        <Border Style="{StaticResource ModernCard}" Padding="24"
                                            Visibility="{Binding IsCardPayTab, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Pay via Card (Utilities &amp; Services)" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                                                <TextBlock Text="Instant settlement for utility bills, internet providers, and merchants." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,14"/>

                                                <!-- Active Card Selector / Info -->
                                                <TextBlock Text="SELECT PAYMENT CARD" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedPaymentCard}" ItemsSource="{Binding Cards}" DisplayMemberPath="MaskedNumber" Margin="0,0,0,12"/>

                                                <!-- Biller Category -->
                                                <TextBlock Text="UTILITY / SERVICE BILLER" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedBiller}" ItemsSource="{Binding BillerCategories}" Margin="0,0,0,12"/>

                                                <!-- Customer / Account Number -->
                                                <TextBlock Text="BILL / METER / CUSTOMER NO" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BillerAccountNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                                <!-- Amount -->
                                                <TextBlock Text="BILL AMOUNT (BDT)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CardPayAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                                <UniformGrid Columns="5" Margin="0,0,0,12">
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳2,500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="2500"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                                    <Button Style="{StaticResource ChipBtn}" Content="৳10,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="10000"/>
                                                </UniformGrid>

                                                <!-- Security Verification CVV -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="CARD CVV (3-DIGIT)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CardPayCvv, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="REMARKS / MONTH" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CardPayNote, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Card Surcharge & Total -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="E-Commerce Card Processing" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Text="Convenience Tariff: ৳10.00 | Instant Biller Clearing" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="Total Charged" Foreground="{StaticResource BrushTextMuted}" FontSize="10" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding CardPayTotalDebit, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Button Style="{StaticResource PrimaryBtn}" Height="46" Command="{Binding ExecuteCardPayCommand}">
                                                    <TextBlock Text="Authorize &amp; Pay Bill with Card" FontWeight="Bold" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- RIGHT COLUMN: SAVED BENEFICIARIES & SPECIFICATIONS -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Beneficiary Directory Card -->
                                        <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Saved Payees &amp; Beneficiaries" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock Text="Directory of verified accounts &amp; wallets" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="30" Padding="10,0"
                                                        Command="{Binding OpenAddBeneficiaryCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushCyan}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Add Payee" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Beneficiaries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrushEmeraldPill}" Margin="0,0,12,0">
                                                                            <TextBlock Text="{Binding AvatarInitials}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding BankName}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                                                                <TextBlock Text=" • " Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                                                <TextBlock Text="{Binding AccountNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontFamily="Consolas, Courier New"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border Background="{StaticResource BrushCyanPill}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                                <TextBlock Text="{Binding Channel, FallbackValue='NPSB'}" Foreground="{StaticResource BrushCyan}" FontSize="9" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <Button Style="{StaticResource SecondaryBtn}" Height="28" Padding="8,0" Margin="0,0,4,0"
                                                                                Command="{Binding DataContext.SelectBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" ToolTip="Select for transfer">
                                                                                <TextBlock Text="Select" FontSize="11"/>
                                                                            </Button>
                                                                            <Button Style="{StaticResource SecondaryBtn}" Height="28" Width="28" Padding="0"
                                                                                Command="{Binding DataContext.DeleteBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" ToolTip="Delete payee">
                                                                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushRose}" Width="8" Height="8" Stretch="Uniform"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bangladeshi Banking Network Limits & Tariffs Card -->
                                        <Border Style="{StaticResource ModernCard}" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="Bangladesh Bank Payment Rails &amp; Tariffs" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,12,0"/>

                                                <!-- NPSB -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="NPSB (National Payment Switch BD)" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Instant 24/7/365 | Max ৳300,000 / txn" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Fee: ৳10.00" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- BEFTN -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="BEFTN (Electronic Funds Transfer)" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Automated Clearing | Max ৳500,000 / batch" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Fee: ৳5.00" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- RTGS -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="RTGS (Real Time Gross Settlement)" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="High-Value Transfers | Min ৳100,000" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Fee: ৳100.00" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- MFS -->
                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="MFS (bKash / Nagad Wallet Direct)" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Instant Mobile Wallet Disbursal | Max ৳25,000 / day" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="Fee: ৳15.00" Foreground="{StaticResource BrushAmber}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- APX Bank Same Bank -->
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="APX Bank PLC Same-Bank Internal" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold"/>
                                                            <TextBlock Text="Instant Account-to-Account | Unlimited Volume" Foreground="#065F46" FontSize="10"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="FREE (৳0.00)" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============================================================ -->
                        <!-- VIEW 3: CARDS STUDIO                                         -->
                        <!-- ============================================================ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36"
                                  Visibility="{Binding CurrentView, Converter={StaticResource EqToVisConverter}, ConverterParameter='Cards'}">
                            <Grid Margin="24,20,24,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Cards Studio &amp; Controls" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="Manage virtual &amp; physical cards, security policies, and spending boundaries." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="460"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card Preview Card -->
                                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="24">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Card.Tier, FallbackValue='Primary Virtual Card'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Card.Brand, StringFormat='Brand: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Card.Last4, StringFormat='**** {0}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Card Graphic -->
                                            <Border Height="230" CornerRadius="16" Background="{StaticResource BrushCardVirtualGradient}" BorderBrush="#255D4E" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,16">
                                                <Grid Margin="22">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Frozen Overlay -->
                                                    <Border Grid.RowSpan="3" Background="{StaticResource BrushCardFrozenOverlay}" 
                                                        Visibility="{Binding Card.IsFrozen, Converter={StaticResource BoolToVisConverter}}"
                                                        CornerRadius="16" Margin="-22" Panel.ZIndex="10">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconLock}" Fill="White" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <TextBlock Text="LOCKED &amp; FROZEN" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Grid Grid.Row="0">
                                                        <Border Width="40" Height="28" Background="#D4AF37" CornerRadius="4" BorderBrush="#B8860B" BorderThickness="1" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Card.Brand, FallbackValue='VISA'}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding DisplayedCardNumber}" Foreground="White" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas, Courier New"/>

                                                    <Grid Grid.Row="2">
                                                        <StackPanel HorizontalAlignment="Left">
                                                            <TextBlock Text="HOLDER" Foreground="#6EE7B7" FontSize="9"/>
                                                            <TextBlock Text="{Binding Card.CardHolder}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Right">
                                                            <TextBlock Text="EXPIRES / CVV" Foreground="#6EE7B7" FontSize="9" HorizontalAlignment="Right"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Card.Expiry}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                                                <TextBlock Text=" • " Foreground="#6EE7B7" FontSize="13" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding DisplayedCvv}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                                <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Command="{Binding ToggleRevealCardCommand}" Content="{Binding RevealButtonText}"/>
                                                <Button Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" Command="{Binding ToggleFreezeCardCommand}">
                                                    <TextBlock Text="Freeze / Unfreeze" Foreground="{StaticResource BrushRose}"/>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Cards Selector Deck -->
                                            <Grid Margin="0,10,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Your Cards Deck" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Cards.Count, StringFormat='Total: {0}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>

                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Cards}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Tier}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding MaskedNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas, Courier New" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsFrozen, Converter={StaticResource InvBoolToVisConverter}}">
                                                                            <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Border Background="{StaticResource BrushRosePill}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisConverter}}">
                                                                            <TextBlock Text="FROZEN" Foreground="{StaticResource BrushRose}" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <!-- Security Controls Settings -->
                                    <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="24">
                                        <StackPanel>
                                            <TextBlock Text="Security &amp; Transaction Rules" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,16,0"/>

                                            <!-- Setting 1: Online Purchases -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Online E-Commerce Transactions" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Allow web and in-app checkout authorizations" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource ModernToggleSwitch}" 
                                                              IsChecked="{Binding Card.OnlinePurchasesEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleOnlinePurchasesCommand}"
                                                              VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.OnlinePurchasesEnabled, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="ENABLED" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="{StaticResource BrushRosePill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.OnlinePurchasesEnabled, Converter={StaticResource InvBoolToVisConverter}}">
                                                            <TextBlock Text="DISABLED" Foreground="{StaticResource BrushRose}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Setting 2: Contactless Payments -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="NFC Contactless &amp; Apple Pay" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Tap-to-pay at POS terminals with biometric confirmation" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource ModernToggleSwitch}" 
                                                              IsChecked="{Binding Card.ContactlessEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleContactlessCommand}"
                                                              VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.ContactlessEnabled, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="ENABLED" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="{StaticResource BrushRosePill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.ContactlessEnabled, Converter={StaticResource InvBoolToVisConverter}}">
                                                            <TextBlock Text="DISABLED" Foreground="{StaticResource BrushRose}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Setting 3: International Payments -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="International Cross-Border Settlements" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="No foreign exchange markup (0% interbank rate)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource ModernToggleSwitch}" 
                                                              IsChecked="{Binding Card.InternationalPaymentsEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleInternationalCommand}"
                                                              VerticalAlignment="Center"/>
                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.InternationalPaymentsEnabled, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="ENABLED" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="{StaticResource BrushRosePill}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding Card.InternationalPaymentsEnabled, Converter={StaticResource InvBoolToVisConverter}}">
                                                            <TextBlock Text="DISABLED" Foreground="{StaticResource BrushRose}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Daily Limit Adjuster -->
                                            <TextBlock Text="{Binding CardDailyLimitText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,6"/>
                                            <Slider Value="{Binding CardDailyLimitValue, Mode=TwoWay}" Minimum="5000" Maximum="500000" SmallChange="5000" LargeChange="25000" Margin="0,0,0,16"/>

                                            <Button Style="{StaticResource PrimaryBtn}" Height="42" HorizontalAlignment="Left"
                                                Command="{Binding GenerateNewCardCommand}" Cursor="Hand" Padding="16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Generate New Disposable Virtual Card" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============================================================ -->
                        <!-- VIEW 4: ANALYTICS & BUDGET                                   -->
                        <!-- ============================================================ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36"
                                  Visibility="{Binding CurrentView, Converter={StaticResource EqToVisConverter}, ConverterParameter='Analytics'}">
                            <Grid Margin="24,20,24,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                    <TextBlock Text="Financial Analytics &amp; Intelligence" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="Deep inspection into spending velocity, category allocations, and net cash flow." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Spending Category Breakdown Progress Bars -->
                                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="24">
                                        <StackPanel>
                                            <TextBlock Text="Outflow Allocation by Category" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                                            <ItemsControl ItemsSource="{Binding SpendingCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,14">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding FormattedAmount}" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{Binding FormattedPercentage}" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <ProgressBar Height="8" Value="{Binding Percentage}" Maximum="100" 
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                                                         Background="#E2E8F0" BorderThickness="0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right: Cash Flow & Financial Health -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="September Cashflow Ratio" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,14,0"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Total Inflow" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding TotalMonthlyInflow, StringFormat='+৳{0:N2}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="20" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Total Outflow" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding TotalMonthlyOutflow, StringFormat='-৳{0:N2}'}" Foreground="{StaticResource BrushRose}" FontSize="20" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding NetMonthlySavings, StringFormat='NET SURPLUS: +৳{0:N2}'}" Foreground="{StaticResource BrushCyan}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ModernCard}" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="Financial Health Score" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                                                <TextBlock Text="94 / 100 • EXCELLENT" Foreground="{StaticResource BrushEmeraldDark}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBlock Text="Your emergency reserve covers 14.2 months of fixed obligations. Liquidity velocity is optimal." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============================================================ -->
                        <!-- VIEW 5: ALL TRANSACTIONS LEDGER (In-App View)                -->
                        <!-- ============================================================ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,36"
                                  Visibility="{Binding CurrentView, Converter={StaticResource EqToVisConverter}, ConverterParameter='Transactions'}">
                            <Grid Margin="24,20,24,24" DataContext="{Binding Ledger}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Top Greeting / Action Bar -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 4 Summary Metric Cards -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Filters & Sorting Bar -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Table Header -->
                                    <RowDefinition Height="*"/>
                                    <!-- Scrollable Transactions List -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="All Transactions Ledger" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="Real-time multi-account audit trail synchronized with APX Bank PLC Enterprise Database" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryBtn}" Height="34" Command="{Binding OpenDatabaseFileCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Open in Excel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Path Data="{StaticResource IconExternalLink}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Summary Metrics (4 Cards) -->
                                <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,18">
                                    <!-- Card 1: Records Count -->
                                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="FILTERED RECORDS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FilteredCount}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TotalCount, StringFormat='{} of {0} total'}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Total Credits (Inflow) -->
                                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL INFLOW (CREDITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TotalInflow, StringFormat='+৳{0:N2}'}" Foreground="{StaticResource BrushEmerald}" FontSize="20" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Total Debits (Outflow) -->
                                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL OUTFLOW (DEBITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TotalOutflow, StringFormat='-৳{0:N2}'}" Foreground="{StaticResource BrushRose}" FontSize="20" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Net Flow -->
                                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="NET LEDGER VOLUME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding NetVolume, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushCyan}" FontSize="20" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Row 2: Search, Category, Flow Type & Sort Controls -->
                                <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Search Input + Reset Filters -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Live Search Input -->
                                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                                <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,12,8"/>
                                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Reset Filters Button -->
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="38" Command="{Binding ResetFiltersCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Reset Filters" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Category Filter Pills -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Category: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="All"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Income" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Income"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Shopping" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Shopping"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Transfer" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transfer"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Groceries" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Groceries"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Entertainment" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Entertainment"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Transport" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transport"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Flow Type & Sorting Options -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Type Filter -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                                                <TextBlock Text="Flow Type: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="All"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Credits (+)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Credit"/>
                                                <Button Style="{StaticResource PillBtn}" Content="Debits (-)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Debit"/>
                                            </StackPanel>

                                            <!-- Sorting Pills -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Sort By: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Newest">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconCalendarClock}" Fill="{StaticResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Newest" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Oldest">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconCalendarClock}" Fill="{StaticResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Oldest" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Highest">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconTrendingUp}" Fill="{StaticResource BrushEmerald}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Highest" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Lowest">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconTrendingDown}" Fill="{StaticResource BrushRose}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Lowest" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Payee: A to Z">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconSortAlpha}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Payee A-Z" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Payee: Z to A">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconSortAlpha}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Payee Z-A" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Table Header -->
                                <Border Grid.Row="3" Background="{StaticResource BrushBorderSubtle}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10,10,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <!-- Category -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Title / Description -->
                                            <ColumnDefinition Width="110"/>
                                            <!-- Status -->
                                            <ColumnDefinition Width="170"/>
                                            <!-- Date -->
                                            <ColumnDefinition Width="130"/>
                                            <!-- Reference # -->
                                            <ColumnDefinition Width="130"/>
                                            <!-- Amount -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CATEGORY" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="PAYEE / DESCRIPTION" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="STATUS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="DATE &amp; TIME" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="4" Text="REFERENCE" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="5" Text="AMOUNT" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Scrollable Transactions List -->
                                <Border Grid.Row="4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                                    <ItemsControl ItemsSource="{Binding FilteredTransactions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Category Badge -->
                                                        <Border Grid.Column="0" Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" Fill="{StaticResource BrushTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource BrushTextPrimary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Title & Description -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Status Pill -->
                                                        <Border Grid.Column="2" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- Date & Time -->
                                                        <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>

                                                        <!-- Reference # -->
                                                        <TextBlock Grid.Column="4" Text="{Binding ReferenceNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>

                                                        <!-- Amount -->
                                                        <TextBlock Grid.Column="5" Text="{Binding Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                               Foreground="{Binding Amount, Converter={StaticResource AmountColorConverter}}" 
                                                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============================================================ -->
                        <!-- DEPOSIT FUNDS MODAL OVERLAY                                  -->
                        <!-- ============================================================ -->
                        <Border Background="#60000000" Visibility="{Binding IsDepositDialogOpen, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="100">
                            <Border Style="{StaticResource ModernCard}" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Deposit Funds" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                        <Button Grid.Column="1" Style="{StaticResource TitleBarBtn}" Command="{Binding CloseDepositDialogCommand}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="DESTINATION ACCOUNT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAccount.Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedAccount.Balance, StringFormat='Current balance: ৳{0:N2}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="DEPOSIT AMOUNT (BDT)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,14">
                                        <Button Style="{StaticResource ChipBtn}" Content="৳500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="500"/>
                                        <Button Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                        <Button Style="{StaticResource ChipBtn}" Content="৳2,500" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="2500"/>
                                        <Button Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="2,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                    </UniformGrid>

                                    <TextBlock Text="PAYMENT SOURCE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding DepositSource, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                                    <Button Style="{StaticResource PrimaryBtn}" Height="44" Command="{Binding ExecuteDepositCommand}">
                                        <TextBlock Text="Confirm Deposit" FontWeight="Bold" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- ============================================================ -->
                        <!-- TRANSACTION RECEIPT MODAL OVERLAY                            -->
                        <!-- ============================================================ -->
                        <Border Background="#60000000" Visibility="{Binding SelectedTransaction, Converter={StaticResource NullToVisConverter}}" Panel.ZIndex="110">
                            <Border Style="{StaticResource ModernCard}" Width="460" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Transaction Receipt" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedTransaction.ReferenceNumber, StringFormat='Ref: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource TitleBarBtn}" Command="{Binding CloseSelectedTransactionCommand}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <!-- Large Amount Display -->
                                    <Border Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedTransaction.Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                   Foreground="{Binding SelectedTransaction.Amount, Converter={StaticResource AmountColorConverter}}" 
                                                   FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="SETTLED • COMPLETED" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Details Key-Values -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Merchant / Payee" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedTransaction.Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Description" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedTransaction.Description}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" HorizontalAlignment="Right" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Category" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedTransaction.Category}" Foreground="{StaticResource BrushCyan}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                                    <Grid Margin="0,0,0,16">
                                        <TextBlock Text="Timestamp" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedTransaction.Timestamp, StringFormat='{}{0:MMMM dd, yyyy - hh:mm tt}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource SecondaryBtn}" Height="40" Margin="0,0,6,0" Command="{Binding CloseSelectedTransactionCommand}">
                                            <TextBlock Text="Close"/>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryBtn}" Height="40" Margin="6,0,0,0" Command="{Binding DownloadReceiptPdfCommand}">
                                            <TextBlock Text="Download PDF Receipt"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- ============================================================ -->
                        <!-- ADD BENEFICIARY MODAL OVERLAY                                -->
                        <!-- ============================================================ -->
                        <Border Background="#60000000" Visibility="{Binding IsAddBeneficiaryOpen, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="115">
                            <Border Style="{StaticResource ModernCard}" Width="480" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Add Beneficiary / Payee" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="Register a new domestic bank account or MFS wallet" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource TitleBarBtn}" Command="{Binding CloseAddBeneficiaryCommand}">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="PAYEE FULL NAME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewBenName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DESTINATION BANK" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding NewBenBank}" ItemsSource="{Binding SupportedBanks}" DisplayMemberPath="BankName"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="DEFAULT RAIL" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding NewBenChannel}" ItemsSource="{Binding BdChannels}"/>
