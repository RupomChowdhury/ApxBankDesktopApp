<Window x:Class="ApexBank.TransactionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ApexBank.ViewModels"
        mc:Ignorable="d"
        Title="APX Bank PLC - Complete Transaction Ledger" 
        Icon="Assets/app_icon.ico"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Container with Rounded Border -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BrushBg}" 
            BorderBrush="{StaticResource BrushCardBorder}" 
            BorderThickness="1" 
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Header Bar -->
                <RowDefinition Height="*"/>  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- ==================================================================== -->
            <!-- CUSTOM TITLE BAR                                                     -->
            <!-- ==================================================================== -->
            <Border Grid.Row="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- APX Bank PLC Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1">
                            <Image Source="Assets/SecuredRelay.png" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="APX Bank PLC" Foreground="{StaticResource BrushTextPrimary}" FontSize="17" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushCyanPill}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="FULL LEDGER STUDIO" Foreground="{StaticResource BrushCyan}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Pill -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushEmeraldPill}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushEmerald}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE EXCEL DATABASE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock Text="• Data\ApexBankDatabase.xlsx" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,12,0" Command="{Binding OpenDatabaseFileCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open in Excel" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IconExternalLink}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="2" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconMaximize}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseBtn}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================================================================== -->
            <!-- MAIN CONTENT AREA                                                    -->
            <!-- ==================================================================== -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Summary Cards -->
                    <RowDefinition Height="Auto"/> <!-- Filter & Search Controls -->
                    <RowDefinition Height="Auto"/> <!-- Table Header -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Transactions List -->
                </Grid.RowDefinitions>

                <!-- ROW 0: SUMMARY METRICS (4 Cards) -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="-6,0,-6,16">
                    <!-- Card 1: Records Count -->
                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="FILTERED RECORDS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FilteredCount}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalCount, StringFormat='{} of {0} total'}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Total Credits (Inflow) -->
                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="TOTAL INFLOW (CREDITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalInflow, StringFormat='+৳{0:N2}'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Total Debits (Outflow) -->
                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="TOTAL OUTFLOW (DEBITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalOutflow, StringFormat='-৳{0:N2}'}" Foreground="{StaticResource BrushRose}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Net Flow -->
                    <Border Margin="6,0" Style="{StaticResource ModernCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="NET LEDGER BALANCE" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NetVolume, StringFormat='৳{0:N2}'}" Foreground="{StaticResource BrushCyan}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ROW 1: SEARCH, CATEGORIES, TYPES, SORTING & ACTIONS -->
                <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Line 1: Search Box + Quick Actions -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Search Input -->
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,12,8"/>
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Reset Filters Button -->
                            <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="38" Command="{Binding ResetFiltersCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reset Filters" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Line 2: Category Filter Pills -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Category: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="All"/>
                                <Button Style="{StaticResource PillBtn}" Content="Income" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Income"/>
                                <Button Style="{StaticResource PillBtn}" Content="Shopping" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Shopping"/>
                                <Button Style="{StaticResource PillBtn}" Content="Transfer" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transfer"/>
                                <Button Style="{StaticResource PillBtn}" Content="Groceries" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Groceries"/>
                                <Button Style="{StaticResource PillBtn}" Content="Entertainment" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Entertainment"/>
                                <Button Style="{StaticResource PillBtn}" Content="Transport" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transport"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Line 3: Type Filter & Sorting Options -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Type Filter -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="Flow Type: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="All"/>
                                <Button Style="{StaticResource PillBtn}" Content="Credits (+)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Credit"/>
                                <Button Style="{StaticResource PillBtn}" Content="Debits (-)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Debit"/>
                            </StackPanel>

                            <!-- Sorting Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Sort By: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Newest">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCalendarClock}" Fill="{StaticResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Newest" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Oldest">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCalendarClock}" Fill="{StaticResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Oldest" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Highest">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconTrendingUp}" Fill="{StaticResource BrushEmerald}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Highest" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Lowest">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconTrendingDown}" Fill="{StaticResource BrushRose}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lowest" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Payee: A to Z">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSortAlpha}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Payee A-Z" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Payee: Z to A">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSortAlpha}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Payee Z-A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ROW 2: TABLE HEADER -->
                <Border Grid.Row="2" Background="{StaticResource BrushBorderSubtle}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10,10,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/> <!-- Category -->
                            <ColumnDefinition Width="*"/>   <!-- Title / Description -->
                            <ColumnDefinition Width="110"/> <!-- Status -->
                            <ColumnDefinition Width="170"/> <!-- Date -->
                            <ColumnDefinition Width="130"/> <!-- Reference # -->
                            <ColumnDefinition Width="130"/> <!-- Amount -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CATEGORY" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="PAYEE / DESCRIPTION" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="STATUS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="DATE &amp; TIME" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="REFERENCE" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="AMOUNT" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- ROW 3: SCROLLABLE TRANSACTIONS LIST -->
                <Border Grid.Row="3" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.SelectTransactionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Badge with Dynamic Vector Icon -->
                                            <Border Grid.Column="0" Background="{StaticResource BrushBorderSubtle}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" 
                                                          Fill="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Title & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="2" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Date & Time -->
                                            <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>

                                            <!-- Reference # -->
                                            <TextBlock Grid.Column="4" Text="{Binding ReferenceNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>

                                            <!-- Amount -->
                                            <TextBlock Grid.Column="5" Text="{Binding Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                       Foreground="{Binding Amount, Converter={StaticResource AmountColorConverter}}" 
                                                       FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ============================================================ -->
                <!-- TRANSACTION RECEIPT MODAL OVERLAY                            -->
                <!-- ============================================================ -->
                <Border Grid.RowSpan="4" Background="#60000000" Visibility="{Binding SelectedTransaction, Converter={StaticResource NullToVisConverter}}" Panel.ZIndex="100">
                    <Border Style="{StaticResource ModernCard}" Width="460" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Transaction Details" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedTransaction.ReferenceNumber, StringFormat='Ledger Ref: {0}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource TitleBarBtn}" Command="{Binding CloseDetailsCommand}">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <!-- Amount Display -->
                            <Border Background="{StaticResource BrushBg}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedTransaction.Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                               Foreground="{Binding SelectedTransaction.Amount, Converter={StaticResource AmountColorConverter}}" 
                                               FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="SETTLED • VERIFIED IN EXCEL" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Merchant / Payee" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTransaction.Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Description" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTransaction.Description}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" HorizontalAlignment="Right" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Category" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTransaction.Category}" Foreground="{StaticResource BrushCyan}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,6,0,6"/>

                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Timestamp" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedTransaction.Timestamp, StringFormat='{}{0:MMMM dd, yyyy - hh:mm tt}'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Button Style="{StaticResource PrimaryBtn}" Height="40" Command="{Binding CloseDetailsCommand}">
                                <TextBlock Text="Done" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>