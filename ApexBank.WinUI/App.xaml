<Application
    x:Class="ApexBank.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ApexBank.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:AmountColorConverter x:Key="AmountColorConverter" />
            <converters:AmountPrefixConverter x:Key="AmountPrefixConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
            <converters:EqualityToVisibilityConverter x:Key="EqToVisConverter" />
            <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
            <converters:EqualityToBooleanConverter x:Key="EqToBoolConverter" />
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:TransactionCategoryToIconConverter x:Key="TransactionCategoryToIconConverter" />
            <converters:TransactionCategoryToIconConverter x:Key="CategoryToIconConverter" />
            <converters:TransactionCategoryToBrushConverter x:Key="TransactionCategoryToBrushConverter" />
            <converters:TransactionCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
