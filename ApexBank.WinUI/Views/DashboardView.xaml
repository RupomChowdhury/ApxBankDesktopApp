<UserControl
    x:Class="ApexBank.WinUI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Greeting & Quick Actions -->
                <RowDefinition Height="Auto"/> <!-- Row 1: 4 Top KPI Metric Cards -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Account Quick Switcher Pill Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Dual Column: Spline Area Chart + Quick Transfer & Card -->
                <RowDefinition Height="Auto"/> <!-- Row 4: Recent Transactions Data Table -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top Greeting & Quick Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome back, Alexander" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Unified real-time banking command center • APX Bank PLC" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Command="{Binding OpenDepositDialogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Funds" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding NavigateCommand}" CommandParameter="Transfers">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconArrowUpRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Send Money" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: 4 Top KPI Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Net Assets -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL NET ASSETS" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                            <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,2">
                                <TextBlock Text="+14.2% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalNetWorth, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Consolidated portfolio balance" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- KPI Card 2: Checking Balance -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedAccount.Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="7,2">
                                <TextBlock Text="{Binding SelectedAccount.AccountNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding SelectedAccount.Balance, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Primary operating liquidity" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- KPI Card 3: Monthly Inflow -->
                <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MONTHLY INFLOW" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                            <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,2">
                                <TextBlock Text="+8.5% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalMonthlyInflow, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="30-day verified deposits" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- KPI Card 4: Net Cashflow -->
                <Border Grid.Column="6" Style="{StaticResource ModernCard}" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NET CASHFLOW" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold"/>
                            <Border Grid.Column="1" Background="{StaticResource BrushCyanPill}" CornerRadius="6" Padding="7,2">
                                <TextBlock Text="SAVINGS" Foreground="{StaticResource BrushCyan}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding NetMonthlySavings, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Net monthly savings retained" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Account Quick Switcher Pill Bar -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,16,0">
                        <Path Data="{StaticResource IconBankPillars}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SELECT ACCOUNT:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0"
                                        Command="{Binding DataContext.SelectAccountCommand, ElementName=AccountRootGrid}" 
                                        CommandParameter="{Binding}">
                                    <Border CornerRadius="8" Padding="12,6" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • " Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Balance, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Height="30" Padding="12,0" Command="{Binding OpenDepositDialogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Deposit" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 3: Dual Column (Spline Cashflow Area Chart + Quick Transfer & Card) -->
            <Grid Grid.Row="3" Margin="0,0,0,20" x:Name="AccountRootGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Spline Cashflow Area Chart -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Filter Pills -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cashflow &amp; Analytics" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Income vs expense trend over selected timeframe" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PillBtn}" Content="1D" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                    <Button Style="{StaticResource PillBtn}" Content="1W" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                    <Button Style="{StaticResource PillBtn}" Content="1M" Height="28" Padding="10,0" Margin="0,0,2,0" Background="#FFFFFF" Foreground="{StaticResource BrushEmeraldDark}" FontWeight="Bold"/>
                                    <Button Style="{StaticResource PillBtn}" Content="1Y" Height="28" Padding="10,0" Margin="0,0,2,0"/>
                                    <Button Style="{StaticResource PillBtn}" Content="All" Height="28" Padding="10,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Stat Highlight Banner -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="৳92,400.00" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                                <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="7,3" Margin="10,0,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="+18.4% ▲" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="30-day continuous cashflow curve" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- Spline Area Chart Canvas -->
                        <Grid Grid.Row="2">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                <Border Grid.Row="1" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"/>
                            </Grid>

                            <Viewbox Stretch="Fill">
                                <Canvas Width="700" Height="200">
                                    <!-- Shaded Gradient Area -->
                                    <Path Fill="{StaticResource BrushChartAreaGradient}"
                                          Data="M 0,165 C 50,150 90,120 140,125 C 190,130 230,85 290,80 C 350,75 390,115 450,85 C 510,55 550,30 610,35 C 650,38 675,20 700,25 L 700,200 L 0,200 Z"/>

                                    <!-- Smooth Line Stroke -->
                                    <Path Stroke="{StaticResource BrushEmerald}" StrokeThickness="3.5"
                                          Data="M 0,165 C 50,150 90,120 140,125 C 190,130 230,85 290,80 C 350,75 390,115 450,85 C 510,55 550,30 610,35 C 650,38 675,20 700,25"/>

                                    <!-- Peak Dot -->
                                    <Ellipse Canvas.Left="600" Canvas.Top="25" Width="20" Height="20" Fill="#2010B981"/>
                                    <Ellipse Canvas.Left="605" Canvas.Top="30" Width="10" Height="10" Fill="{StaticResource BrushEmerald}"/>
                                    <Ellipse Canvas.Left="607.5" Canvas.Top="32.5" Width="5" Height="5" Fill="#FFFFFF"/>

                                    <!-- Value Tooltip -->
                                    <Border Canvas.Left="545" Canvas.Top="0" Background="#0F172A" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="14 Sep: ৳92,400" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- Day Markers & Legend -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Tue" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Wed" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Thu" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Fri" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Sat" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Sun" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushEmerald}" Margin="0,0,6,0"/>
                                <TextBlock Text="Inflow" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,14,0"/>
                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrushRose}" Margin="0,0,6,0"/>
                                <TextBlock Text="Outflow" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: Quick Transfer & Virtual Card -->
                <StackPanel Grid.Column="2">
                    <!-- QUICK SEND WIDGET -->
                    <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Quick Transfer" Foreground="{StaticResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Frequent Beneficiaries -->
                            <TextBlock Text="FREQUENT BENEFICIARIES" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Beneficiaries}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Padding="0"
                                                Command="{Binding DataContext.SelectBeneficiaryCommand, ElementName=AccountRootGrid}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Width="60" HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding AvatarInitials}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recipient Input -->
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransferRecipientName, Mode=TwoWay}" Margin="0,0,0,8" Height="38"/>

                            <!-- Amount Input -->
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TransferAmount, Mode=TwoWay}" Height="38" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ChipBtn}" Content="৳500" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="500"/>
                                <Button Grid.Column="1" Style="{StaticResource ChipBtn}" Content="৳1,000" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="1000"/>
                                <Button Grid.Column="2" Style="{StaticResource ChipBtn}" Content="৳2,500" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="2500"/>
                                <Button Grid.Column="3" Style="{StaticResource ChipBtn}" Content="৳5,000" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="5000"/>
                                <Button Grid.Column="4" Style="{StaticResource ChipBtn}" Content="৳10k" Margin="1,0" Command="{Binding QuickAmountCommand}" CommandParameter="10000"/>
                            </Grid>

                            <!-- Transfer Button -->
                            <Button Style="{StaticResource PrimaryBtn}" Height="40" HorizontalAlignment="Stretch" Command="{Binding ExecuteTransferCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconArrowUpRight}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Transfer Now" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- VIRTUAL CARD PREVIEW WIDGET -->
                    <Border Style="{StaticResource ModernCard}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Virtual Debit Card" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" 
                                            Command="{Binding ToggleRevealCardCommand}" Content="{Binding RevealButtonText}" FontSize="11"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Height="26" Padding="8,0" 
                                            Command="{Binding ToggleFreezeCardCommand}">
                                        <TextBlock Text="Freeze" Foreground="{StaticResource BrushRose}" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Compact Card Surface -->
                            <Border Height="165" CornerRadius="12" Background="{StaticResource BrushCardVirtualGradient}" BorderBrush="#255D4E" BorderThickness="1">
                                <Grid Margin="16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Frozen Overlay -->
                                    <Border Grid.RowSpan="3" Background="{StaticResource BrushCardFrozenOverlay}" 
                                            Visibility="{Binding Card.IsFrozen, Converter={StaticResource BoolToVisConverter}}"
                                            CornerRadius="12" Margin="-16,-14">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLock}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="CARD FROZEN" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top: Chip & Visa -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="22" Background="#D4AF37" CornerRadius="3" BorderBrush="#B8860B" BorderThickness="1"/>
                                        <Path Grid.Column="1" Data="{StaticResource IconWave}" Fill="#E2E8F0" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="VISA" Foreground="White" FontSize="15" FontWeight="ExtraBold" FontStyle="Italic"/>
                                    </Grid>

                                    <!-- Middle: Masked / Full Number -->
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayedCardNumber}" 
                                               Foreground="White" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" FontFamily="Consolas, Courier New"/>

                                    <!-- Bottom: Cardholder, Expiry, CVV -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CARDHOLDER" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Card.CardHolder}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="EXPIRES" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Card.Expiry}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CVV" Foreground="#6EE7B7" FontSize="8" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DisplayedCvv}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 4: Recent Transactions Data Table -->
            <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Count Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Recent Transactions" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource BrushCyanPill}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Latest Records" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Search & Filter Chips -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Grid Grid.Column="0">
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search transactions..." Height="36"/>
                        </Grid>

                        <!-- Filter Pills -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="All"/>
                            <Button Style="{StaticResource PillBtn}" Content="Income" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Income"/>
                            <Button Style="{StaticResource PillBtn}" Content="Shopping" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Shopping"/>
                            <Button Style="{StaticResource PillBtn}" Content="Transfer" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Transfer"/>
                            <Button Style="{StaticResource PillBtn}" Content="Groceries" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Groceries"/>
                            <Button Style="{StaticResource PillBtn}" Content="Entertainment" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Entertainment"/>
                            <Button Style="{StaticResource PillBtn}" Content="Transport" Margin="0,0,6,0" Command="{Binding SetFilterCategoryCommand}" CommandParameter="Transport"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,1" Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TRANSACTION &amp; DETAILS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="CATEGORY" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="STATUS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="DATE &amp; TIME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="AMOUNT" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Transactions Tabular List -->
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding RecentTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectTransactionCommand, ElementName=AccountRootGrid}" 
                                        CommandParameter="{Binding}">
                                    <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,12" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 0: Icon + Title + Description -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="36" Height="36" CornerRadius="8" 
                                                        Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Path Data="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" 
                                                          Fill="{StaticResource BrushTextPrimary}" Width="15" Height="15" Stretch="Uniform" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Column 1: Category Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Column 2: Status Badge (Completed) -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="Completed" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Column 3: Date & Time -->
                                            <TextBlock Grid.Column="3" Text="{Binding Timestamp}" 
                                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>

                                            <!-- Column 4: Amount -->
                                            <TextBlock Grid.Column="4" Text="{Binding Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                       Foreground="{Binding Amount, Converter={StaticResource AmountColorConverter}}" 
                                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Footer Navigation to Full Ledger -->
                    <Button Grid.Row="4" Style="{StaticResource SecondaryBtn}" Height="36" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding NavigateCommand}" CommandParameter="Transactions">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Open Full Transaction Ledger" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconExternalLink}" Fill="{StaticResource BrushCyan}" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
