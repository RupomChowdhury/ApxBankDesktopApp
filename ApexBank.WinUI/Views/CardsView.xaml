<UserControl
    x:Class="ApexBank.WinUI.Views.CardsView"
    x:Name="CardsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Cards Studio &amp; Controls" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Manage virtual &amp; physical cards, security policies, and spending boundaries." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Card Preview & Deck -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Card.Tier, FallbackValue='Primary Virtual Card'}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Card.Brand, FallbackValue='VISA'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Card.Last4, FallbackValue='**** 4242'}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Card Graphic -->
                        <Border Height="230" CornerRadius="16" Background="{StaticResource BrushCardVirtualGradient}" BorderBrush="#255D4E" BorderThickness="1" Margin="0,0,0,16">
                            <Grid Margin="22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Frozen Overlay -->
                                <Border Grid.RowSpan="3" Background="{StaticResource BrushCardFrozenOverlay}" 
                                        Visibility="{Binding Card.IsFrozen, Converter={StaticResource BoolToVisConverter}}"
                                        CornerRadius="16" Margin="-22">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLock}" Fill="White" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="LOCKED &amp; FROZEN" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="0">
                                    <Border Width="40" Height="28" Background="#D4AF37" CornerRadius="4" BorderBrush="#B8860B" BorderThickness="1" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Card.Brand, FallbackValue='VISA'}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding DisplayedCardNumber}" Foreground="White" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas, Courier New"/>

                                <Grid Grid.Row="2">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="HOLDER" Foreground="#6EE7B7" FontSize="9"/>
                                        <TextBlock Text="{Binding Card.CardHolder}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="EXPIRES / CVV" Foreground="#6EE7B7" FontSize="9" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Card.Expiry}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text=" • " Foreground="#6EE7B7" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DisplayedCvv}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" HorizontalAlignment="Stretch" Command="{Binding ToggleRevealCardCommand}" Content="{Binding RevealButtonText}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0" HorizontalAlignment="Stretch" Command="{Binding ToggleFreezeCardCommand}">
                                <TextBlock Text="Freeze / Unfreeze" Foreground="{StaticResource BrushRose}"/>
                            </Button>
                        </Grid>

                        <!-- Cards Selector Deck -->
                        <Grid Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Your Cards Deck" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Primary &amp; Backup Cards" Foreground="{StaticResource BrushEmeraldDark}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding ElementName=CardsRoot, Path=DataContext.SelectCardCommand}"
                                                CommandParameter="{Binding}" Margin="0,0,0,6">
                                            <Border Padding="12,9" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Tier}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MaskedNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas, Courier New" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource BrushEmeraldPill}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsFrozen, Converter={StaticResource InvBoolToVisConverter}}">
                                                            <TextBlock Text="ACTIVE" Foreground="{StaticResource BrushEmeraldDark}" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="{StaticResource BrushRosePill}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="FROZEN" Foreground="{StaticResource BrushRose}" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Right Column: Native WinUI 3 ToggleSwitch Security Controls -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Security &amp; Transaction Rules" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                        <!-- Setting 1: Online Purchases with native ToggleSwitch -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Online E-Commerce Transactions" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Allow web and in-app checkout authorizations" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="Enabled" OffContent="Disabled"
                                              IsOn="{Binding Card.OnlinePurchasesEnabled, Mode=OneWay}"
                                              Toggled="OnlinePurchases_Toggled"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Setting 2: Contactless Payments with native ToggleSwitch -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="NFC Contactless &amp; Tap-to-Pay" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tap-to-pay at POS terminals with biometric confirmation" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="Enabled" OffContent="Disabled"
                                              IsOn="{Binding Card.ContactlessEnabled, Mode=OneWay}"
                                              Toggled="Contactless_Toggled"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Setting 3: International Payments with native ToggleSwitch -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="International Cross-Border Settlements" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="No foreign exchange markup (0% interbank rate)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="Enabled" OffContent="Disabled"
                                              IsOn="{Binding Card.InternationalPaymentsEnabled, Mode=OneWay}"
                                              Toggled="International_Toggled"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Daily Limit Adjuster -->
                        <TextBlock Text="{Binding CardDailyLimitText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,6"/>
                        <Slider Value="{Binding CardDailyLimitValue, Mode=TwoWay}" Minimum="5000" Maximum="500000" StepFrequency="5000" Margin="0,0,0,16"/>

                        <Button Style="{StaticResource PrimaryBtn}" Height="42" HorizontalAlignment="Left"
                                Command="{Binding GenerateNewCardCommand}" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generate New Disposable Virtual Card" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
