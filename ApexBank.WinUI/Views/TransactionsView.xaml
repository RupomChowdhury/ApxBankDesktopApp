<UserControl
    x:Class="ApexBank.WinUI.Views.TransactionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,36">
        <Grid Margin="24,20,24,24" DataContext="{Binding Ledger}" x:Name="LedgerGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Greeting / Action Bar -->
                <RowDefinition Height="Auto"/> <!-- 4 Summary Metric Cards -->
                <RowDefinition Height="Auto"/> <!-- Filters & Sorting Bar -->
                <RowDefinition Height="Auto"/> <!-- Table Header -->
                <RowDefinition Height="*"/>    <!-- Scrollable Transactions List -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="All Transactions Ledger" Foreground="{StaticResource BrushTextPrimary}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Real-time multi-account audit trail synchronized with APX Bank PLC Enterprise Database" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryBtn}" Height="34" Command="{Binding OpenDatabaseFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open in Excel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconExternalLink}" Fill="{StaticResource BrushCyan}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Summary Metrics (4 Cards) -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Records Count -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="FILTERED RECORDS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilteredCount}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text=" matches" Foreground="{StaticResource BrushTextMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Total Credits (Inflow) -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="TOTAL INFLOW (CREDITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalInflow, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Total Debits (Outflow) -->
                <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="TOTAL OUTFLOW (DEBITS)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalOutflow, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushRose}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Net Flow -->
                <Border Grid.Column="6" Style="{StaticResource ModernCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="NET LEDGER VOLUME" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NetVolume, Converter={StaticResource AmountPrefixConverter}}" Foreground="{StaticResource BrushCyan}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Search, Category, Flow Type & Sort Controls -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Search Input + Reset Filters -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Search Input -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search by description, reference, or amount..."/>
                        </Grid>

                        <!-- Reset Filters Button -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Height="38" Command="{Binding ResetFiltersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset Filters" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Category Filter Pills -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Category: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="All"/>
                            <Button Style="{StaticResource PillBtn}" Content="Income" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Income"/>
                            <Button Style="{StaticResource PillBtn}" Content="Shopping" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Shopping"/>
                            <Button Style="{StaticResource PillBtn}" Content="Transfer" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transfer"/>
                            <Button Style="{StaticResource PillBtn}" Content="Groceries" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Groceries"/>
                            <Button Style="{StaticResource PillBtn}" Content="Entertainment" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Entertainment"/>
                            <Button Style="{StaticResource PillBtn}" Content="Transport" Margin="0,0,6,0" Command="{Binding SetCategoryCommand}" CommandParameter="Transport"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Flow Type & Sorting Options -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Type Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="Flow Type: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="All"/>
                            <Button Style="{StaticResource PillBtn}" Content="Credits (+)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Credit"/>
                            <Button Style="{StaticResource PillBtn}" Content="Debits (-)" Margin="0,0,6,0" Command="{Binding SetTypeCommand}" CommandParameter="Debit"/>
                        </StackPanel>

                        <!-- Sorting Pills -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Sort By: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Newest" Content="Newest"/>
                                <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Date: Oldest" Content="Oldest"/>
                                <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Highest" Content="Highest"/>
                                <Button Style="{StaticResource PillBtn}" Margin="0,0,6,0" Command="{Binding SetSortOptionCommand}" CommandParameter="Amount: Lowest" Content="Lowest"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 3: Table Header -->
            <Border Grid.Row="3" Background="{StaticResource BrushBorderSubtle}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10,10,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CATEGORY" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="PAYEE / DESCRIPTION" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="STATUS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="DATE &amp; TIME" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="REFERENCE" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="AMOUNT" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Row 4: Scrollable Transactions List -->
            <Border Grid.Row="4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
                <ItemsControl ItemsSource="{Binding FilteredTransactions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Category Badge -->
                                        <Border Grid.Column="0" Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" Fill="{StaticResource BrushTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource BrushTextPrimary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Title & Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Status Pill -->
                                        <Border Grid.Column="2" Background="{StaticResource BrushEmeraldPill}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushEmeraldDark}" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Date & Time -->
                                        <TextBlock Grid.Column="3" Text="{Binding Timestamp}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>

                                        <!-- Reference # -->
                                        <TextBlock Grid.Column="4" Text="{Binding ReferenceNumber}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <!-- Amount -->
                                        <TextBlock Grid.Column="5" Text="{Binding Amount, Converter={StaticResource AmountPrefixConverter}}" 
                                                   Foreground="{Binding Amount, Converter={StaticResource AmountColorConverter}}" 
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
